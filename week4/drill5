<?php
$filename = 'sales.csv';


if (!file_exists($filename)) {
    $file = fopen($filename, 'w');
    fputcsv($file, ['ID', 'Date', 'Product', 'Amount', 'Region']);

    $products = ['Laptop', 'Phone', 'Tablet', 'Monitor', 'Keyboard'];
    $regions  = ['North', 'South', 'East', 'West'];

    for ($i = 1; $i <= 50; $i++) {
        $row = [
            $i,
            date('Y-m-d', strtotime("-" . rand(1, 30) . " days")),
            $products[array_rand($products)],
            rand(50, 1500),
            $regions[array_rand($regions)]
        ];
        fputcsv($file, $row);
    }
    fclose($file);
}


$file = fopen($filename, 'r');
$headers = fgetcsv($file); // Read first row as headers

$data = [];
while (($row = fgetcsv($file)) !== false) {
    // Combine headers with row values to make associative array
    $data[] = array_combine($headers, $row);
}
fclose($file);

// --- STEP 3: HANDLE FILTERING ---
$filter_region = $_GET['region'] ?? '';
if (!empty($filter_region)) {
    $data = array_filter($data, function ($row) use ($filter_region) {
        return $row['Region'] === $filter_region;
    });
}

// --- STEP 4: HANDLE SORTING ---
$sort_column = $_GET['sort'] ?? '';
$sort_order  = $_GET['order'] ?? 'asc';

if (!empty($sort_column) && in_array($sort_column, $headers)) {
    usort($data, function ($a, $b) use ($sort_column, $sort_order) {
        // Numeric vs String comparison
        if (is_numeric($a[$sort_column]) && is_numeric($b[$sort_column])) {
            $result = $a[$sort_column] <=> $b[$sort_column];
        } else {
            $result = strcasecmp($a[$sort_column], $b[$sort_column]);
        }
        return ($sort_order === 'asc') ? $result : -$result;
    });
}

// --- STEP 5: HANDLE CSV DOWNLOAD EXPORT ---
if (isset($_GET['action']) && $_GET['action'] === 'download') {
    // Send standard HTTP headers for file download
    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename="filtered_sales_export.csv"');

    $output = fopen('php://output', 'w');
    fputcsv($output, $headers); // Write headers

    foreach ($data as $row) {
        fputcsv($output, $row); // Write filtered/sorted data
    }

    fclose($output);
    exit; // Stop executing script so HTML isn't appended
}
?>

