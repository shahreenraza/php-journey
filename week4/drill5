                <?php foreach ($headers as $col): 
                    // Toggle sort direction on each click
                    $next_order = ($sort_column === $col && $sort_order === 'asc') ? 'desc' : 'asc';
                    
                    $link_params = $_GET;
                    $link_params['sort'] = $col;
                    $link_params['order'] = $next_order;
                    $sort_url = 'sales.php?' . http_build_query($link_params);
                    
                    $arrow = '';
                    if ($sort_column === $col) {
                        $arrow = $sort_order === 'asc' ? ' ▲' : ' ▼';
                    }
                ?>
                    <th>
                        <a href="<?= htmlspecialchars($sort_url) ?>">
                            <?= htmlspecialchars($col) . $arrow ?>
                        </a>
                    </th>
                <?php endforeach; ?>
