<?php
$email   = '';
$phone   = '';
$subject = '';
$message = '';
$consent = false; 
$errors  = [];    

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    
    
    $name    = trim($_POST['name'] ?? '');
    $email   = trim($_POST['email'] ?? '');
    $phone   = trim($_POST['phone'] ?? '');
    $subject = trim($_POST['subject'] ?? '');
    $message = trim($_POST['message'] ?? '');
    
    
    $consent = isset($_POST['consent']); 

    if (empty($name)) {
        $errors['name'] = "Name cannot be blank.";
    }

    
    if (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $errors['email'] = "Please enter a valid email address.";
    }

    
    if (empty($phone)) {
        $errors['phone'] = "Phone number is required.";
    }

    
    if (empty($subject)) {
        $errors['subject'] = "Please select a subject option.";
    }

   
    if (empty($message)) {
        $errors['message'] = "Message area cannot be empty.";
    }

    
    if ($consent === false) {
        $errors['consent'] = "You must agree to the terms to proceed.";
    }

   
    if (empty($errors)) {
        
        
        $formData = [
            'name'      => $name,
            'email'     => $email,
            'phone'     => $phone,
            'subject'   => $subject,
            'message'   => $message,
            'submitted_at' => date('Y-m-d H:i:s')
        ];

        
        $existingData = [];
        if (file_exists('submissions.json') && filesize('submissions.json') > 0) {
            $existingData = json_decode(file_get_contents('submissions.json'), true) ?? [];
        }

       
        $existingData[] = $formData;

       
        file_put_contents('submissions.json', json_encode($existingData, JSON_PRETTY_PRINT));

        
        header("Location: thank-you.php");
        exit; 
    }
}
?>

