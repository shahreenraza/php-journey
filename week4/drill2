<?php
$comments = file_exists('comments.txt') ? file('comments.txt') : [];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
$comment = $_POST['comment'] ?? '';
if(!empty($comment)){
file_put_contents('comments.txt', $comment . PHP_EOL, FILE_APPEND);
$comments = file('comments.txt');
}
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments</title>
</head>
<body>
    <form method="POST">
     <textarea name="comment"rows="4" cols="50" placeholder="Write a comment..."></textarea><br>
     <button type="submit">Submit</button>
    </form>
    <hr>
    <h2>Recent comments</h2>
    <?php if(!empty($comments)):?>
        <?php foreach($comments as $c):?>
            <div class="comment">
            <?php echo htmlspecialchars($c, ENT_QUOTES, 'UTF-8'); ?>
            </div>
        <?php endforeach; ?>
    <?php else: ?>
        <p>No comments yet!</p>
    <?php endif; ?>
</body>
</html>
