<?php

$posts = require 'posts.php';

usort($posts, function ($a, $b) {
    return strtotime($b['date']) - strtotime($a['date']);
});


$page = $_GET['page'] ?? 1;

if ($page < 1) {
    $page = 1;
}

$totalPages = ceil(count($posts) / 3);

if ($page > $totalPages) {
    $page = $totalPages;
}

$start = ($page - 1) * 3;

$pagePosts = array_slice($posts, $start, 3);


foreach ($pagePosts as $post) {

    echo "<article>";

    echo "<h2>";
    echo $post['title'];
    echo "</h2>";

    echo "<small>";
    echo $post['date'];
    echo "</small>";

    echo "<p>";
    echo $post['excerpt'];
    echo "</p>";

    echo "</article>";
}


echo "<div>";

for ($i = 1; $i <= $totalPages; $i++) {
    echo "<a href='index.php?page=$i'>$i</a> ";
}

echo "</div>";



