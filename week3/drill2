function isPalindrome(string $text): bool {
    $cleanedText = strtolower($text);
    $cleanedText = str_replace(" ", "", $cleanedText);
    $reversedText = strrev($cleanedText);
    return ($cleanedText == $reversedText);
}
echo "Type a word or sentence to check: ";
$userInput = readline();
if (isPalindrome($userInput)) {
    echo "🎉 Yes! '$userInput' is a palindrome." . PHP_EOL;
} else {
    echo "❌ No, '$userInput' is NOT a palindrome." . PHP_EOL;
}

